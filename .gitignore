# Go build/test caches (kept inside the repo so the DinD-mounted volume persists them)
.gocache/
cover.out
cover.html

# Built binaries
/dependaproxy
/bin/

# Local databases / cache dirs
*.db
/cache/
# web/ (Vite + React + TS scaffold, issue #140)
web/node_modules/
web/dist/
web/playwright-report/
web/test-results/
web/coverage/
web/*.tsbuildinfo

# web UI embed build outputs (issue #152). The committed placeholder
# internal/webui/dist/index.html stays tracked; the real build overwrites it
# and adds the rest — restore with `git checkout internal/webui/dist/index.html`.
internal/webui/dist/*
!internal/webui/dist/index.html
